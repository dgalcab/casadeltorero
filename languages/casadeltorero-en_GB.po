msgstr "Address"

msgid "Envíanos un mensaje"
msgstr "Send us a message"

msgid "Cuéntanos qué fechas te interesan y cualquier detalle especial. Te responderemos con disponibilidad y una propuesta personalizada."
msgstr "Tell us which dates you are interested in and any special requirements. We will reply with availability and a personalised proposal."

msgid "Nombre"
msgstr "Name"

msgid "Tu nombre"
msgstr "Your name"

msgid "Número de personas"
msgstr "Number of guests"

msgid "— Selecciona —"
msgstr "— Select —"

